---
import type { Project } from '../lib/types';
import { Image } from 'astro:assets';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const base = '';

const displayTech = project.technologies.slice(0, 3);
const extraTechCount = project.technologies.length - 3;
---

<article class="group h-full">
  <a href={`${base}/proyectos/${project.slug}`} class="block h-full">
    <div class="aspect-video bg-surface overflow-hidden relative">
      {project.featured_image_url ? (
        <Image
          src={project.featured_image_url}
          alt={`Captura de ${project.title}`}
          class="w-full h-full object-cover transition-transform duration-300 ease group-hover:scale-[1.02]"
          width={780}
          height={439}
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center" style="font-family: var(--font-mono)">
          <span class="text-secondary text-2xl">{project.title.charAt(0).toUpperCase()}</span>
        </div>
      )}
    </div>

    <div class="p-5 border-t border-border group-hover:border-accent/40 transition-colors duration-150">
      <h3 class="text-[16px] font-medium text-text leading-snug group-hover:text-accent transition-colors duration-150">
        {project.title}
      </h3>

      {project.short_description && (
        <p class="mt-2 text-[14px] text-secondary leading-relaxed line-clamp-2">
          {project.short_description}
        </p>
      )}

      <div class="mt-4 flex flex-wrap items-center gap-2" style="font-family: var(--font-mono)">
        {displayTech.map((tech) => (
          <span class="inline-flex items-center px-2 py-[3px] text-[11px] bg-surface text-text/70 border border-border/60 rounded-sm">
            {tech.name}
          </span>
        ))}
        {extraTechCount > 0 && (
          <span class="text-[11px] text-secondary">+{extraTechCount}</span>
        )}
      </div>
    </div>
  </a>
</article>
