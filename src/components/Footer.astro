---
import type { Profile } from '../lib/types';

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();

// Fallback for build-time env in static mode
const gitSha = (import.meta.env.GITHUB_SHA ?? 'local').slice(0, 7);
---

<footer class="border-t border-border mt-20">
  <div class="container-main py-10">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 text-[13px] text-secondary" style="font-family: var(--font-mono)">
      <div>
        <span class="text-text">{year}</span> · {profile.name}
      </div>

      <div class="flex items-center gap-4">
        <a
          href="https://github.com/dreayacucho/portfolio-astro-v1"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-accent transition-colors duration-150"
        >
          Código fuente
        </a>
        <span class="text-border">·</span>
        <span class="text-secondary/60" title="Commit del build">
          {gitSha}
        </span>
      </div>
    </div>

    <p class="mt-4 text-[12px] text-secondary/50" style="font-family: var(--font-mono)">
      Construido con Astro · Datos desde la API
    </p>
  </div>
</footer>
