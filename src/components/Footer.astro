---
import type { Profile } from '../lib/types';
import GridBand from './GridBand.astro';

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
const year = new Date().getFullYear();
const gitSha = (import.meta.env.GITHUB_SHA ?? 'local').slice(0, 7);
---

<GridBand as="footer" last={true} markers={false}>
  <div class="grid-inner py-10">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
      <div class="flex flex-col gap-1">
        <div class="flex items-center gap-2.5 text-[14px]">
          <span class="font-mono font-medium text-text font-variant-numeric-tabular">{year}</span>
          <span class="text-border-strong" aria-hidden="true">/</span>
          <span class="font-medium text-text">{profile.name}</span>
        </div>
        <p class="text-[13px] text-secondary">{profile.professional_title}</p>
      </div>

      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-[13px] font-mono text-secondary">
        {profile.social_links.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-accent transition-colors duration-150 underline-offset-4 hover:underline"
          >
            {link.platform}
          </a>
        ))}
        <a
          href="https://github.com/urufudev/urufudev.github.io"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-accent transition-colors duration-150 underline-offset-4 hover:underline"
        >
          Código fuente
        </a>
      </div>
    </div>

    <div class="mt-8 pt-5 border-t border-border flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 text-[12px] font-mono text-secondary">
      <p>Astro · API · Tailwind</p>
      <p class="font-variant-numeric-tabular" title="Commit del build">
        build · {gitSha}
      </p>
    </div>
  </div>
</GridBand>
