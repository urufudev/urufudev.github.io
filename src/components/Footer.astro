---
import type { Profile } from '../lib/types';

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
const base = '';
const year = new Date().getFullYear();
const gitSha = (import.meta.env.GITHUB_SHA ?? 'local').slice(0, 7);
---

<footer class="relative">
  {/* Top architectural divider */}
  <div class="arch-divider" aria-hidden="true"></div>

  <div class="container-main py-10">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 text-[13px] text-secondary" style="font-family: var(--font-mono)">
      <div class="flex items-center gap-3">
        <span class="text-text font-medium">{year}</span>
        <span class="text-border">/</span>
        <span>{profile.name}</span>
      </div>

      <div class="flex items-center gap-4">
        <a
          href="https://github.com/urufudev/urufudev.github.io"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-accent transition-colors duration-150 btn-tactile"
        >
          Código fuente
        </a>
        <span class="text-border">·</span>
        <span class="text-secondary/40 font-variant-numeric-tabular" title="Commit del build">
          {gitSha}
        </span>
      </div>
    </div>

    <div class="mt-6 flex items-center gap-3">
      <div class="h-px flex-1 bg-border/40" aria-hidden="true"></div>
      <p class="text-[11px] text-secondary/40" style="font-family: var(--font-mono)">
        Astro · API · Tailwind
      </p>
      <div class="h-px flex-1 bg-border/40" aria-hidden="true"></div>
    </div>
  </div>
</footer>
