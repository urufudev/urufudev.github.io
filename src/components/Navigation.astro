---
import type { Profile } from '../lib/types';

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;

const navItems = [
  { label: 'Inicio', href: '/' },
  { label: 'Proyectos', href: '/proyectos' },
  { label: 'Sobre mí', href: '/sobre-mi' },
  { label: 'Contacto', href: '/contacto' },
];

const base = '';
const currentPath = Astro.url.pathname.replace(base, '') || '/';
---

<header class="lg:w-[240px] lg:fixed lg:h-screen lg:top-0 lg:left-0 z-40 bg-bg">
  <div class="hidden lg:block absolute top-8 bottom-8 right-0 w-px bg-border" aria-hidden="true"></div>

  <div class="lg:h-full lg:flex lg:flex-col lg:justify-between lg:py-10 lg:px-8">
    {/* Mobile header */}
    <div class="flex items-center justify-between px-6 py-4 lg:hidden border-b border-border">
      <a href={`${base}/`} class="text-[15px] font-medium tracking-tight" style="font-family: var(--font-sans)">
        {profile.name}
      </a>
      <div class="flex items-center gap-2">
        <button
          type="button"
          id="theme-toggle-mobile"
          class="p-2 text-secondary hover:text-text transition-colors duration-150 btn-tactile"
          aria-label="Cambiar tema"
          title="Cambiar tema"
        >
          <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
          <svg class="moon-icon hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
        </button>
        <button
          type="button"
          class="p-2 -mr-2 btn-tactile"
          aria-label="Abrir menú"
          aria-expanded="false"
          id="menu-toggle"
          x-data="{ open: false }"
          @click="open = !open; $refs.navpanel.classList.toggle('hidden', !open); $el.setAttribute('aria-expanded', open)"
        >
          <svg x-show="!open" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
          <svg x-show="open" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display: none"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>
    </div>

    {/* Navigation panel */}
    <nav
      x-ref="navpanel"
      id="nav-panel"
      class="hidden lg:block px-6 pb-6 lg:px-0 lg:pb-0 border-b border-border lg:border-b-0"
    >
      {/* Desktop name */}
      <div class="hidden lg:block mb-12">
        <a href={`${base}/`} class="block text-[15px] font-medium tracking-tight leading-tight" style="font-family: var(--font-sans)">
          {profile.name}
        </a>
        <span class="mt-2 block text-[11px] text-secondary leading-relaxed" style="font-family: var(--font-mono)">
          {profile.professional_title}
        </span>

        <div class="mt-6 flex items-center gap-1 text-border" aria-hidden="true">
          <span class="text-[10px]" style="font-family: var(--font-mono)">+</span>
          <div class="flex-1 h-px bg-border"></div>
        </div>
      </div>

      <ul class="space-y-0">
        {navItems.map((item, index) => {
          const isActive = currentPath === item.href || currentPath.startsWith(item.href + '/');
          return (
            <li class="relative">
              {index > 0 && (
                <div class="absolute top-0 left-0 right-0 h-px bg-border/60" aria-hidden="true"></div>
              )}
              <a
                href={`${base}${item.href}`}
                class={`block py-3 text-[14px] transition-colors duration-150 ease ${isActive ? 'text-accent font-medium' : 'text-text hover:text-accent'}`}
                aria-current={isActive ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>

      {/* Bottom section */}
      <div class="hidden lg:block mt-12">
        <div class="flex items-center gap-2 text-border mb-8" aria-hidden="true">
          <div class="w-8 h-px bg-border"></div>
          <span class="text-[9px] uppercase tracking-widest" style="font-family: var(--font-mono)">2025</span>
        </div>

        {/* Theme toggle */}
        <button
          type="button"
          id="theme-toggle"
          class="flex items-center gap-2 text-[12px] text-secondary hover:text-text transition-colors duration-150 btn-tactile py-2"
          style="font-family: var(--font-mono)"
          aria-label="Cambiar tema"
        >
          <span class="theme-icon-wrapper">
            <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
            <svg class="moon-icon hidden" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
          </span>
          <span class="theme-label">Tema</span>
        </button>

        {/* Social links */}
        <div class="flex items-center gap-4 mt-6">
          {profile.social_links.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-secondary hover:text-accent transition-colors duration-150 btn-tactile"
              aria-label={link.platform}
              title={link.platform}
            >
              {link.platform === 'GitHub' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
              )}
              {link.platform === 'LinkedIn' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
              )}
              {!['GitHub', 'LinkedIn'].includes(link.platform) && (
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
              )}
            </a>
          ))}
        </div>
      </div>
    </nav>
  </div>

  {/* Theme toggle script */}
  <script is:inline>
    (function() {
      function updateIcons(isDark) {
        document.querySelectorAll('.sun-icon').forEach(el => el.classList.toggle('hidden', isDark));
        document.querySelectorAll('.moon-icon').forEach(el => el.classList.toggle('hidden', !isDark));
      }

      function toggleTheme() {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        updateIcons(isDark);
      }

      // Initialize icons
      updateIcons(document.documentElement.classList.contains('dark'));

      document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
      document.getElementById('theme-toggle-mobile')?.addEventListener('click', toggleTheme);
    })();
  </script>
</header>
