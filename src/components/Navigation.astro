---
import type { Profile } from '../lib/types';

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;

const navItems = [
  { label: 'Inicio', href: '/' },
  { label: 'Proyectos', href: '/proyectos' },
  { label: 'Sobre mí', href: '/sobre-mi' },
  { label: 'Contacto', href: '/contacto' },
];

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname.replace(base, '') || '/';
---

<header class="lg:w-[240px] lg:fixed lg:h-screen lg:top-0 lg:left-0 z-40">
  <div class="lg:h-full lg:flex lg:flex-col lg:justify-between lg:py-12 lg:px-8 bg-bg border-b lg:border-b-0 lg:border-r border-border">
    {/* Mobile header */}
    <div class="flex items-center justify-between px-6 py-4 lg:hidden">
      <a href={`${base}/`} class="text-lg font-medium tracking-tight" style="font-family: var(--font-sans)">
        {profile.name}
      </a>
      <button
        type="button"
        class="p-2 -mr-2"
        aria-label="Abrir menú"
        aria-expanded="false"
        id="menu-toggle"
        x-data="{ open: false }"
        @click="open = !open; $refs.navpanel.classList.toggle('hidden', !open); $el.setAttribute('aria-expanded', open)"
      >
        <svg x-show="!open" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
        <svg x-show="open" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display: none"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>

    {/* Navigation panel */}
    <nav
      x-ref="navpanel"
      id="nav-panel"
      class="hidden lg:block px-6 pb-6 lg:px-0 lg:pb-0"
    >
      {/* Desktop name */}
      <div class="hidden lg:block mb-10">
        <a href={`${base}/`} class="block text-lg font-medium tracking-tight leading-tight" style="font-family: var(--font-sans)">
          {profile.name}
        </a>
        <span class="mt-1 block text-xs text-secondary" style="font-family: var(--font-mono)">
          {profile.professional_title}
        </span>
      </div>

      <ul class="space-y-1">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || currentPath.startsWith(item.href + '/');
          return (
            <li>
              <a
                href={`${base}${item.href}`}
                class={`block py-1.5 text-[15px] transition-colors duration-150 ease ${isActive ? 'text-accent' : 'text-text hover:text-accent'}`}
                aria-current={isActive ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>

      {/* Social links - desktop only */}
      <div class="hidden lg:flex items-center gap-3 mt-10">
        {profile.social_links.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-secondary hover:text-accent transition-colors duration-150"
            aria-label={link.platform}
            title={link.platform}
          >
            {link.platform === 'GitHub' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
            )}
            {link.platform === 'LinkedIn' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
            )}
            {!['GitHub', 'LinkedIn'].includes(link.platform) && (
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            )}
          </a>
        ))}
      </div>
    </nav>
  </div>
</header>
