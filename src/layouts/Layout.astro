---
import '../styles/global.css';
import { getProfile } from '../lib/api';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishDate?: string;
}

const profile = await getProfile();
const {
  title,
  description = profile.bio ?? profile.professional_title,
  image,
  type = 'website',
  publishDate,
} = Astro.props;
const pageTitle = title ? `${title} · ${profile.name}` : profile.name;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <SEO
      title={pageTitle}
      description={description}
      image={image}
      type={type}
      publishDate={publishDate}
    />
    <slot name="head" />

    {/* Theme script - runs before render to prevent flash */}
    <script is:inline>
      (function() {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-bg text-text">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2 focus:bg-bg focus:text-text focus:border focus:border-accent focus:rounded-[4px] focus:text-[13px] focus:font-mono"
    >
      Saltar al contenido
    </a>

    <div class="grid-canvas flex flex-col min-h-screen">
      <Navigation profile={profile} />

      <main id="main" class="flex-1 min-w-0 relative flex flex-col">
        <slot />
      </main>

      <Footer profile={profile} />
    </div>
  </body>
</html>
