---
import Layout from '../layouts/Layout.astro';
import { getProfile } from '../lib/api';

const profile = await getProfile();
---

<Layout title="Contacto">
  <section class="pt-12 lg:pt-16 pb-6">
    <div class="container-main">
      <div class="section-marker mb-4">
        <span>Escríbeme</span>
      </div>
      <h1 class="text-[32px] lg:text-[44px] font-medium tracking-tighter leading-[1.1] text-text">Contacto</h1>
      <p class="mt-6 text-[16px] leading-[1.7] text-text/80 max-w-[65ch]">
        Si tienes una pregunta, una idea o simplemente quieres hablar de código, escríbeme. Respondo en cuanto puedo.
      </p>
    </div>
  </section>

  <section class="py-6 pb-20">
    <div class="container-main max-w-[640px]">
      {/* Structural border container */}
      <div class="border border-border rounded-sm p-6 lg:p-10 relative">
        {/* Corner markers */}
        <span class="absolute -top-[3px] -left-[3px] w-[7px] h-[7px] text-border select-none pointer-events-none flex items-center justify-center" aria-hidden="true">
          <svg width="7" height="7" viewBox="0 0 7 7" fill="none"><path d="M3.5 0v7M0 3.5h7" stroke="currentColor" stroke-width="0.75"/></svg>
        </span>
        <span class="absolute -top-[3px] -right-[3px] w-[7px] h-[7px] text-border select-none pointer-events-none flex items-center justify-center" aria-hidden="true">
          <svg width="7" height="7" viewBox="0 0 7 7" fill="none"><path d="M3.5 0v7M0 3.5h7" stroke="currentColor" stroke-width="0.75"/></svg>
        </span>
        <span class="absolute -bottom-[3px] -left-[3px] w-[7px] h-[7px] text-border select-none pointer-events-none flex items-center justify-center" aria-hidden="true">
          <svg width="7" height="7" viewBox="0 0 7 7" fill="none"><path d="M3.5 0v7M0 3.5h7" stroke="currentColor" stroke-width="0.75"/></svg>
        </span>
        <span class="absolute -bottom-[3px] -right-[3px] w-[7px] h-[7px] text-border select-none pointer-events-none flex items-center justify-center" aria-hidden="true">
          <svg width="7" height="7" viewBox="0 0 7 7" fill="none"><path d="M3.5 0v7M0 3.5h7" stroke="currentColor" stroke-width="0.75"/></svg>
        </span>

        <div
          data-api-url={import.meta.env.PUBLIC_API_URL ?? 'https://cv.dreayacucho.gob.pe/api'}
          x-data="{
            name: '',
            email: '',
            subject: '',
            message: '',
            website: '',
            status: 'idle',
            errors: {},
            errorMessage: '',
            async submit() {
              if (this.website) return;
              this.status = 'loading';
              this.errors = {};
              this.errorMessage = '';
              const apiUrl = $el.closest('[data-api-url]')?.dataset?.apiUrl || 'https://cv.dreayacucho.gob.pe/api';
              try {
                const res = await fetch(apiUrl + '/contact', {
                  method: 'POST',
                  headers: {
                    'Content-Type': 'application/json',
                    Accept: 'application/json',
                  },
                  body: JSON.stringify({
                    name: this.name,
                    email: this.email,
                    subject: this.subject || undefined,
                    message: this.message,
                  }),
                });
                if (res.status === 422) {
                  const data = await res.json();
                  this.errors = data.errors || {};
                  this.status = 'error';
                  return;
                }
                if (res.status === 429) {
                  this.errorMessage = 'Demasiados intentos. Intenta en un momento.';
                  this.status = 'error';
                  return;
                }
                if (!res.ok) throw new Error();
                this.status = 'success';
                this.name = '';
                this.email = '';
                this.subject = '';
                this.message = '';
              } catch {
                this.errorMessage = 'Algo salió mal. Intenta de nuevo o escríbeme directamente a ' + '${profile.email}';
                this.status = 'error';
              }
            }
          }"
          @submit.prevent="submit"
        >
          <form class="space-y-8">
            {/* Honeypot */}
            <div class="absolute opacity-0 pointer-events-none" aria-hidden="true">
              <input type="text" name="website" tabindex="-1" autocomplete="off" x-model="website" />
            </div>

            {/* Name */}
            <div>
              <label for="name" class="block text-[11px] uppercase tracking-[0.08em] text-secondary mb-3" style="font-family: var(--font-mono)">Nombre</label>
              <input
                type="text"
                id="name"
                x-model="name"
                required
                maxlength="255"
                class="w-full bg-transparent border-0 border-b border-border py-2.5 text-[15px] text-text placeholder:text-secondary/30 focus:outline-none focus:border-accent transition-colors duration-150"
                placeholder="Tu nombre"
              />
              <p x-show="errors.name" x-text="errors.name?.[0]" class="mt-2 text-[13px] text-error" style="display: none;"></p>
            </div>

            {/* Email */}
            <div>
              <label for="email" class="block text-[11px] uppercase tracking-[0.08em] text-secondary mb-3" style="font-family: var(--font-mono)">Email</label>
              <input
                type="email"
                id="email"
                x-model="email"
                required
                maxlength="255"
                class="w-full bg-transparent border-0 border-b border-border py-2.5 text-[15px] text-text placeholder:text-secondary/30 focus:outline-none focus:border-accent transition-colors duration-150"
                placeholder="tu@email.com"
              />
              <p x-show="errors.email" x-text="errors.email?.[0]" class="mt-2 text-[13px] text-error" style="display: none;"></p>
            </div>

            {/* Subject */}
            <div>
              <label for="subject" class="block text-[11px] uppercase tracking-[0.08em] text-secondary mb-3" style="font-family: var(--font-mono)">
                Asunto <span class="normal-case text-secondary/40">(opcional)</span>
              </label>
              <input
                type="text"
                id="subject"
                x-model="subject"
                maxlength="255"
                class="w-full bg-transparent border-0 border-b border-border py-2.5 text-[15px] text-text placeholder:text-secondary/30 focus:outline-none focus:border-accent transition-colors duration-150"
                placeholder="¿De qué se trata?"
              />
            </div>

            {/* Message */}
            <div>
              <label for="message" class="block text-[11px] uppercase tracking-[0.08em] text-secondary mb-3" style="font-family: var(--font-mono)">Mensaje</label>
              <textarea
                id="message"
                x-model="message"
                required
                maxlength="5000"
                rows="5"
                class="w-full bg-transparent border-0 border-b border-border py-2.5 text-[15px] text-text placeholder:text-secondary/30 focus:outline-none focus:border-accent transition-colors duration-150 resize-y"
                placeholder="Escribe tu mensaje..."
              ></textarea>
              <p x-show="errors.message" x-text="errors.message?.[0]" class="mt-2 text-[13px] text-error" style="display: none;"></p>
            </div>

            {/* Submit */}
            <div class="pt-4 flex items-center justify-between">
              <button
                type="submit"
                :disabled="status === 'loading'"
                class="inline-flex items-center gap-2 text-[14px] text-accent hover:text-white hover:bg-accent px-5 py-2.5 border border-accent/30 rounded-sm transition-all duration-150 disabled:opacity-50 disabled:cursor-not-allowed btn-tactile"
                style="font-family: var(--font-mono)"
              >
                <template x-if="status === 'loading'">
                  <svg class="animate-spin" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                </template>
                <span x-text="status === 'loading' ? 'Enviando...' : 'Enviar mensaje'"></span>
              </button>

              {/* Status messages */}
              <div class="flex items-center gap-3">
                <span x-show="status === 'success'" class="text-[14px] text-accent" style="display: none;">
                  Mensaje enviado
                </span>
                <span x-show="status === 'error' && errorMessage" x-text="errorMessage" class="text-[13px] text-error max-w-[280px] text-right" style="display: none;"></span>
              </div>
            </div>
          </form>
        </div>
      </div>

      {/* Direct contact fallback */}
      <div class="mt-10 pt-8 border-t border-border">
        <p class="text-[14px] text-secondary text-center">
          ¿Prefieres algo más directo?{' '}
          <a href={`mailto:${profile.email}`} class="text-accent hover:text-accent-hover transition-colors duration-150 underline underline-offset-2">
            {profile.email}
          </a>
        </p>
      </div>
    </div>
  </section>
</Layout>
