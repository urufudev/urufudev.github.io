---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProfile, getProjects, getExperiences, getTechnologies } from '../lib/api';
import { formatPeriod } from '../lib/utils';

const profile = await getProfile();
const projects = await getProjects();
const experiences = await getExperiences();
const techGroups = await getTechnologies();

const featuredProjects = projects.slice(0, 4);
const recentExperiences = experiences.slice(0, 2);

// Flatten and get top technologies by level
const allTech = techGroups.flatMap((g) => g.technologies);
const topTechs = allTech.sort((a, b) => b.level - a.level).slice(0, 8);

const base = import.meta.env.BASE_URL;
---

<Layout>
  {/* Hero */}
  <section class="pt-16 lg:pt-24 pb-12">
    <div class="container-main">
      <h1 class="text-[28px] lg:text-[40px] font-medium tracking-tight leading-tight text-text" style="font-family: var(--font-sans)">
        {profile.name}
      </h1>
      <p class="mt-3 text-[18px] lg:text-[20px] text-secondary leading-relaxed">
        {profile.professional_title}
      </p>
      <p class="mt-6 text-[16px] leading-[1.7] text-text max-w-[65ch]">
        Probablemente estoy depurando algo en este momento. El código que escribí hace 6 meses me parece extraño. Señal de progreso.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-6">
        <a href={`${base}/proyectos`} class="inline-flex items-center gap-2 text-[15px] text-accent hover:text-accent-hover transition-colors duration-150 group">
          Ver proyectos
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-150 group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        {profile.cv_url && (
          <a href={profile.cv_url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-[15px] text-accent hover:text-accent-hover transition-colors duration-150 group">
            Descargar CV
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-150 group-hover:translate-y-0.5" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
          </a>
        )}
      </div>

      {/* Social links */}
      <div class="mt-8 flex items-center gap-4">
        {profile.social_links.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-secondary hover:text-accent transition-colors duration-150"
            aria-label={link.platform}
            title={link.platform}
          >
            {link.platform === 'GitHub' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
            )}
            {link.platform === 'LinkedIn' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
            )}
            {!['GitHub', 'LinkedIn'].includes(link.platform) && (
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* Featured Projects */}
  <section class="py-12">
    <div class="container-main">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-[22px] lg:text-[26px] font-medium text-text">Proyectos destacados</h2>
        <a href={`${base}/proyectos`} class="text-[14px] text-accent hover:text-accent-hover transition-colors duration-150 hidden sm:inline-flex items-center gap-1">
          Ver todos
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {featuredProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>

      {featuredProjects.length === 0 && (
        <p class="text-secondary text-[15px]">Nada aquí todavía.</p>
      )}
    </div>
  </section>

  {/* Recent Experience */}
  <section class="py-12">
    <div class="container-main">
      <h2 class="text-[22px] lg:text-[26px] font-medium text-text mb-8">Experiencia reciente</h2>

      <div class="space-y-6">
        {recentExperiences.map((exp) => (
          <div>
            <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
              <h3 class="text-[16px] font-medium text-text">{exp.position}</h3>
              <span class="text-[12px] text-secondary" style="font-family: var(--font-mono)">
                {formatPeriod(exp.started_at, exp.ended_at, exp.is_current)}
              </span>
            </div>
            <p class="mt-1 text-[15px] text-secondary">{exp.company}</p>
            {exp.work_type_label && (
              <span class="mt-2 inline-block text-[11px] text-secondary bg-surface px-2 py-0.5 rounded" style="font-family: var(--font-mono)">
                {exp.work_type_label}
              </span>
            )}
          </div>
        ))}
      </div>

      <a href={`${base}/sobre-mi`} class="mt-8 inline-flex items-center gap-2 text-[14px] text-accent hover:text-accent-hover transition-colors duration-150">
        Ver experiencia completa
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </section>

  {/* Top Technologies */}
  <section class="py-12">
    <div class="container-main">
      <h2 class="text-[22px] lg:text-[26px] font-medium text-text mb-8">Tecnologías principales</h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-3">
        {topTechs.map((tech) => (
          <div class="flex items-center justify-between py-2 border-b border-border">
            <span class="text-[15px] text-text">{tech.name}</span>
            <span class="text-[12px] text-secondary" style="font-family: var(--font-mono)">
              {tech.category_label}
            </span>
          </div>
        ))}
      </div>

      {topTechs.length === 0 && (
        <p class="text-secondary text-[15px]">Nada aquí todavía.</p>
      )}
    </div>
  </section>
</Layout>
