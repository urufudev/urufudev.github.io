---
import Layout from '../layouts/Layout.astro';

const base = '';
---

<Layout title="Página no encontrada">
  <section class="pt-24 pb-12 min-h-[60vh] flex items-center">
    <div class="container-main text-center">
      <div class="section-marker justify-center mb-8">
        <span>Error 404</span>
      </div>
      <h1 class="text-[64px] lg:text-[96px] font-medium text-secondary/15 leading-none tracking-tighter" style="font-family: var(--font-mono)">404</h1>
      <p class="mt-6 text-[18px] text-secondary">Esta página no existe.</p>
      <a href={`${base}/`} class="mt-8 inline-flex items-center gap-2 text-[15px] text-accent hover:text-accent-hover transition-colors duration-150 btn-tactile">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
        Volver al inicio
      </a>
    </div>
  </section>
</Layout>
