---
import { marked } from 'marked';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import GridBand from '../../components/GridBand.astro';
import { getProjects, getProject } from '../../lib/api';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.slug },
  }));
}

const { slug } = Astro.params;
const projects = await getProjects();
const project = await getProject(slug!);

if (!project) {
  return Astro.redirect('/404');
}

const currentIndex = projects.findIndex((p) => p.slug === slug);
const prevProject = currentIndex > 0 ? projects[currentIndex - 1] : null;
const nextProject = currentIndex < projects.length - 1 ? projects[currentIndex + 1] : null;

const techByCategory = project.technologies.reduce<Record<string, typeof project.technologies>>((acc, tech) => {
  if (!acc[tech.category_label]) acc[tech.category_label] = [];
  acc[tech.category_label].push(tech);
  return acc;
}, {});

const descriptionHtml = project.long_description
  ? (marked.parse(project.long_description, { async: false }) as string)
  : '';
---

<Layout
  title={project.title}
  description={project.short_description || undefined}
  image={project.featured_image_url}
  type="article"
  publishDate={project.realized_at || undefined}
>
  <article>
    {/* Cabecera del proyecto + imagen destacada */}
    <GridBand as="section">
      {/* Breadcrumb y fecha */}
      <div class="grid-inner py-4 border-b border-border flex flex-wrap items-center justify-between gap-4 bg-surface/50">
        <a
          href="/proyectos"
          class="inline-flex items-center gap-1.5 text-[13px] font-mono text-secondary hover:text-accent transition-colors duration-150 group"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-150 group-hover:-translate-x-0.5" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
          <span>Proyectos</span>
        </a>

        {project.realized_at && (
          <time
            datetime={project.realized_at}
            class="text-[13px] text-secondary font-variant-numeric-tabular font-mono"
          >
            {new Date(project.realized_at).toLocaleDateString('es-PE', { year: 'numeric', month: 'long' })}
          </time>
        )}
      </div>

      {/* Título y enlaces principales */}
      <div class="grid-inner py-10 lg:py-12 border-b border-border">
        <div class="section-marker mb-4">
          <span>Proyecto</span>
        </div>
        <h1 class="text-[30px] sm:text-[38px] lg:text-[44px] font-semibold tracking-tighter leading-[1.1] text-text max-w-[26ch]">
          {project.title}
        </h1>

        {project.short_description && (
          <p class="mt-4 text-[17px] text-secondary leading-relaxed max-w-[65ch]">
            {project.short_description}
          </p>
        )}

        {(project.demo_url || project.repo_url) && (
          <div class="mt-6 flex flex-wrap items-center gap-3">
            {project.demo_url && (
              <a
                href={project.demo_url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2 text-[14px] font-medium bg-accent text-accent-contrast border border-accent hover:bg-accent-hover hover:border-accent-hover rounded-[4px] transition-colors duration-150 btn-tactile"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                <span>Demo en vivo</span>
              </a>
            )}
            {project.repo_url && (
              <a
                href={project.repo_url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2 text-[14px] font-medium text-text border border-border hover:border-border-strong hover:text-accent rounded-[4px] transition-colors duration-150 btn-tactile"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                <span>Repositorio</span>
              </a>
            )}
          </div>
        )}
      </div>

      {/* Imagen principal */}
      <div class="aspect-video bg-surface overflow-hidden">
        {project.featured_image_url ? (
          <Image
            src={project.featured_image_url}
            alt={`Vista principal de ${project.title}`}
            class="w-full h-full object-cover"
            width={1040}
            height={585}
            loading="eager"
            fetchpriority="high"
          />
        ) : (
          <div class="w-full h-full flex items-center justify-center font-mono">
            <span class="text-secondary text-4xl">{project.title.charAt(0).toUpperCase()}</span>
          </div>
        )}
      </div>
    </GridBand>

    {/* Descripción + Stack */}
    {(descriptionHtml || Object.keys(techByCategory).length > 0) && (
      <GridBand as="section">
        <div class="grid grid-cols-1 lg:grid-cols-12 lg:divide-x lg:divide-border">
          {descriptionHtml && (
            <div class="lg:col-span-8 grid-inner py-10 lg:py-14">
              <div set:html={descriptionHtml} class="md-content" />
            </div>
          )}

          {Object.keys(techByCategory).length > 0 && (
            <aside class:list={[
              descriptionHtml ? 'lg:col-span-4 border-t lg:border-t-0 border-border' : 'lg:col-span-12',
              'grid-inner py-10 lg:py-14',
            ]}>
              <div class="section-marker mb-6">
                <span>Stack</span>
              </div>
              <div class="space-y-6">
                {Object.entries(techByCategory).map(([category, techs]) => (
                  <div>
                    <h2 class="text-[12px] text-secondary mb-3 uppercase tracking-[0.08em] font-mono font-medium">
                      {category}
                    </h2>
                    <div class="flex flex-wrap gap-2">
                      {techs.map((tech) => (
                        <span class="inline-flex items-center px-2.5 py-1 text-[12px] bg-surface text-text border border-border rounded-[3px] font-mono">
                          {tech.name}
                        </span>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </aside>
          )}
        </div>
      </GridBand>
    )}

    {/* Galería con Lightbox */}
    {project.gallery.length > 0 && (
      <GridBand as="section">
        <div
          x-data={`{
            open: false,
            activeIndex: 0,
            images: ${JSON.stringify(project.gallery)},
            get activeImage() { return this.images[this.activeIndex]?.url || ''; },
            get activeName() { return this.images[this.activeIndex]?.name || ''; },
            get hasPrev() { return this.activeIndex > 0; },
            get hasNext() { return this.activeIndex < this.images.length - 1; },
            go(index) { this.activeIndex = index; this.open = true; },
            prev() { if (this.hasPrev) this.activeIndex--; },
            next() { if (this.hasNext) this.activeIndex++; },
            onKey(e) {
              if (!this.open) return;
              if (e.key === 'ArrowLeft') this.prev();
              if (e.key === 'ArrowRight') this.next();
              if (e.key === 'Escape') this.open = false;
            }
          }`}
          @keydown.window="onKey"
        >
          <div class="grid-inner py-8 border-b border-border flex items-center justify-between gap-4">
            <div class="section-marker">
              <span>Galería</span>
            </div>
            <span class="text-[12px] font-mono text-secondary font-variant-numeric-tabular">
              {project.gallery.length} capturas
            </span>
          </div>

          <div class="overflow-hidden">
            <div class="grid grid-cols-2 sm:grid-cols-3 -mr-px -mb-px">
              {project.gallery.map((img, idx) => (
                <button
                  type="button"
                  class="aspect-[4/3] bg-surface overflow-hidden cursor-pointer border-r border-b border-border hover:opacity-90 transition-opacity duration-150 focus-visible:outline-offset-[-2px]"
                  @click={`go(${idx})`}
                  aria-label={`Ampliar imagen: ${img.name}`}
                >
                  <Image
                    src={img.thumb_url || img.url}
                    alt={img.name}
                    class="w-full h-full object-cover"
                    width={400}
                    height={300}
                    onerror={`this.onerror=null; this.src='${img.url}';`}
                  />
                </button>
              ))}
            </div>
          </div>

          {/* Lightbox dialog */}
          <dialog
            :open="open"
            class="fixed inset-0 z-50 w-full h-full bg-black/95 p-4 m-0 max-w-none max-h-none border-none backdrop:bg-black/95"
            @click.self="open = false"
            x-show="open"
            x-transition:enter="transition-opacity duration-150"
            x-transition:enter-start="opacity-0"
            x-transition:enter-end="opacity-100"
            x-transition:leave="transition-opacity duration-150"
            x-transition:leave-start="opacity-100"
            x-transition:leave-end="opacity-0"
          >
            <div class="flex flex-col items-center justify-center h-full relative">
              <button
                type="button"
                class="absolute top-4 right-4 text-white bg-black/60 border border-white/25 hover:border-white px-3 py-2 rounded-[4px] text-[12px] font-mono inline-flex items-center gap-1.5 cursor-pointer z-10"
                @click="open = false"
                aria-label="Cerrar galería"
              >
                <span>Cerrar</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
              </button>

              <button
                type="button"
                class="absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 text-white bg-black/60 border border-white/25 hover:border-white p-2 sm:p-2.5 rounded-[4px] transition-colors duration-150 disabled:opacity-25 disabled:cursor-not-allowed cursor-pointer z-10"
                @click="prev"
                :disabled="!hasPrev"
                aria-label="Imagen anterior"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
              </button>

              <button
                type="button"
                class="absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 text-white bg-black/60 border border-white/25 hover:border-white p-2 sm:p-2.5 rounded-[4px] transition-colors duration-150 disabled:opacity-25 disabled:cursor-not-allowed cursor-pointer z-10"
                @click="next"
                :disabled="!hasNext"
                aria-label="Imagen siguiente"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
              </button>

              <img
                :src="activeImage"
                :alt="activeName"
                class="max-w-full max-h-[82vh] object-contain select-none"
                @click.stop
              />

              <div class="mt-4 flex items-center gap-3 text-[13px] text-white/90 font-mono">
                <span x-text="`${activeIndex + 1} / ${images.length}`"></span>
                <span class="w-px h-3.5 bg-white/40" aria-hidden="true"></span>
                <span x-text="activeName"></span>
              </div>
            </div>
          </dialog>
        </div>
      </GridBand>
    )}

    {/* Navegación Anterior / Siguiente */}
    <GridBand as="section">
      <nav
        class="grid grid-cols-1 sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x divide-border"
        aria-label="Navegación entre proyectos"
      >
        {prevProject ? (
          <a
            href={`/proyectos/${prevProject.slug}`}
            class="grid-inner py-7 group hover:bg-surface/60 transition-colors duration-150 block"
          >
            <span class="inline-flex items-center gap-1.5 text-[12px] font-mono uppercase tracking-[0.08em] text-secondary group-hover:text-accent transition-colors duration-150">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-150 group-hover:-translate-x-0.5" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
              <span>Anterior</span>
            </span>
            <span class="mt-1.5 block text-[16px] font-medium text-text group-hover:text-accent transition-colors duration-150 truncate">
              {prevProject.title}
            </span>
          </a>
        ) : (
          <div class="hidden sm:block" />
        )}

        {nextProject ? (
          <a
            href={`/proyectos/${nextProject.slug}`}
            class="grid-inner py-7 group hover:bg-surface/60 transition-colors duration-150 block sm:text-right"
          >
            <span class="inline-flex items-center sm:justify-end gap-1.5 text-[12px] font-mono uppercase tracking-[0.08em] text-secondary group-hover:text-accent transition-colors duration-150">
              <span>Siguiente</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-150 group-hover:translate-x-0.5" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </span>
            <span class="mt-1.5 block text-[16px] font-medium text-text group-hover:text-accent transition-colors duration-150 truncate">
              {nextProject.title}
            </span>
          </a>
        ) : (
          <div class="hidden sm:block" />
        )}
      </nav>
    </GridBand>
  </article>
</Layout>
