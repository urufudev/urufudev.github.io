---
import Layout from '../../layouts/Layout.astro';
import GridBand from '../../components/GridBand.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/api';

const projects = await getProjects();

const categories = ['Todos', ...new Set(projects.flatMap((p) => p.technologies.map((t) => t.category_label)))];
const allTechs = [...new Map(projects.flatMap((p) => p.technologies).map((t) => [t.slug, t])).values()];
allTechs.sort((a, b) => a.name.localeCompare(b.name));

const projectFilterMeta = projects.map((p) => ({
  id: p.id,
  categories: [...new Set(p.technologies.map((t) => t.category_label))],
  techs: p.technologies.map((t) => t.slug),
}));
---

<Layout
  title="Proyectos"
  description="Una selección de trabajos recientes. Algunos son personales, otros fueron construidos para resolver problemas reales."
>
  <GridBand as="section">
    <div class="grid-inner py-12 lg:py-16">
      <div class="section-marker mb-4">
        <span>Colección</span>
      </div>
      <h1 class="text-[34px] sm:text-[42px] lg:text-[48px] font-semibold tracking-tighter leading-[1.08] text-text">
        Proyectos
      </h1>
      <p class="mt-4 text-[16px] sm:text-[17px] text-secondary max-w-[62ch] leading-[1.7]">
        Una selección de trabajos recientes. Algunos son personales, otros fueron construidos para resolver problemas reales.
      </p>
    </div>
  </GridBand>

  <GridBand as="section">
    <div
      x-data={`{
        activeCategory: 'Todos',
        activeTech: '',
        items: ${JSON.stringify(projectFilterMeta)},
        matches(id) {
          const item = this.items.find(i => i.id === id);
          if (!item) return false;
          const categoryMatch = this.activeCategory === 'Todos' || item.categories.includes(this.activeCategory);
          const techMatch = this.activeTech === '' || item.techs.includes(this.activeTech);
          return categoryMatch && techMatch;
        },
        get visibleCount() {
          return this.items.filter(i => this.matches(i.id)).length;
        }
      }`}
    >
      {/* Barra de filtros */}
      <div class="grid-inner py-5 border-b border-border flex flex-col md:flex-row md:items-center md:justify-between gap-4 bg-surface/50">
        <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Filtrar por categoría">
          {categories.map((cat) => (
            <button
              type="button"
              class="text-[13px] font-mono py-1.5 px-3 rounded-[4px] border transition-colors duration-150 cursor-pointer btn-tactile"
              :class={`activeCategory === '${cat}' ? 'border-accent bg-accent text-accent-contrast font-medium' : 'border-border bg-bg text-secondary hover:text-text hover:border-border-strong'`}
              @click={`activeCategory = '${cat}'`}
            >
              {cat}
            </button>
          ))}
        </div>

        <div class="flex items-center gap-3">
          <label for="tech-filter" class="text-[12px] text-secondary uppercase tracking-[0.08em] font-mono shrink-0">
            Tecnología
          </label>
          <select
            id="tech-filter"
            x-model="activeTech"
            class="bg-bg text-[13px] font-mono text-text border border-border hover:border-border-strong rounded-[4px] py-1.5 pl-3 pr-8 cursor-pointer transition-colors duration-150"
          >
            <option value="">Todas</option>
            {allTechs.map((tech) => (
              <option value={tech.slug}>{tech.name}</option>
            ))}
          </select>
        </div>
      </div>

      {/* Grilla de proyectos reutilizando ProjectCard + <Image> de astro:assets */}
      <div class="overflow-hidden">
        <div class="grid grid-cols-1 md:grid-cols-2 -mr-px -mb-px">
          {projects.map((project) => (
            <div
              class="border-r border-b border-border"
              x-show={`matches(${project.id})`}
            >
              <ProjectCard project={project} />
            </div>
          ))}
        </div>
      </div>

      {/* Estado vacío */}
      <div
        x-show="visibleCount === 0"
        style="display: none;"
        class="grid-inner py-16 text-center"
      >
        <p class="text-secondary text-[16px]">Nada aquí todavía con ese filtro.</p>
        <button
          type="button"
          @click="activeCategory = 'Todos'; activeTech = ''"
          class="mt-4 inline-flex items-center px-3.5 py-2 text-[13px] font-mono text-accent border border-border hover:border-accent rounded-[4px] transition-colors duration-150 cursor-pointer"
        >
          Restablecer filtros
        </button>
      </div>
    </div>
  </GridBand>
</Layout>
