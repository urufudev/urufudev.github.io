---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects, getTechnologies } from '../../lib/api';

const projects = await getProjects();
const techGroups = await getTechnologies();

// Collect all unique categories present in projects
const categories = ['Todos', ...new Set(projects.flatMap((p) => p.technologies.map((t) => t.category_label)))];

// Collect all unique technologies present in projects
const allTechs = [...new Map(projects.flatMap((p) => p.technologies).map((t) => [t.slug, t])).values()];
allTechs.sort((a, b) => a.name.localeCompare(b.name));

const base = import.meta.env.BASE_URL;
---

<Layout title="Proyectos">
  <section class="pt-12 lg:pt-16 pb-6">
    <div class="container-main">
      <h1 class="text-[28px] lg:text-[40px] font-medium tracking-tight text-text">Proyectos</h1>
      <p class="mt-3 text-[16px] text-secondary max-w-[65ch] leading-relaxed">
        Una selección de trabajos recientes. Algunos son personales, otros fueron construidos para resolver problemas reales.
      </p>
    </div>
  </section>

  <section class="py-6">
    <div class="container-main">
      <div
        x-data={`{
          activeCategory: 'Todos',
          activeTech: '',
          get filtered() {
            return ${JSON.stringify(projects)}.filter(p => {
              const categoryMatch = this.activeCategory === 'Todos' || p.technologies.some(t => t.category_label === this.activeCategory);
              const techMatch = this.activeTech === '' || p.technologies.some(t => t.slug === this.activeTech);
              return categoryMatch && techMatch;
            });
          }
        }`}
      >
        {/* Category filters */}
        <div class="flex flex-wrap items-center gap-2 mb-4">
          {categories.map((cat) => (
            <button
              type="button"
              class="text-[13px] py-1 px-2 transition-colors duration-150 border-b-2"
              :class={`activeCategory === '${cat}' ? 'border-accent text-text' : 'border-transparent text-secondary hover:text-text'`}
              @click={`activeCategory = '${cat}'`}
            >
              {cat}
            </button>
          ))}
        </div>

        {/* Technology filter */}
        <div class="mb-8">
          <select
            x-model="activeTech"
            class="appearance-none bg-transparent text-[13px] text-secondary border-b border-border py-1 pr-6 pl-0 cursor-pointer focus:outline-none focus:border-accent transition-colors duration-150"
            style="font-family: var(--font-mono); background-image: url('data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%2212%22 height=%2212%22 viewBox=%220 0 24 24%22 fill=%22none%22 stroke=%22%2371717a%22 stroke-width=%222%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22%3E%3Cpath d=%22m6 9 6 6 6-6%22/%3E%3C/svg%3E'); background-repeat: no-repeat; background-position: right center;"
          >
            <option value="">Todas las tecnologías</option>
            {allTechs.map((tech) => (
              <option value={tech.slug}>{tech.name}</option>
            ))}
          </select>
        </div>

        {/* Projects grid */}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <template x-for="project in filtered" :key="project.id">
            <div class="transition-all duration-150 ease-out" x-data="{ shown: false }" x-init="setTimeout(() => shown = true, 50)" :class="shown ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-2'">
              {/* We need to render the card manually with Alpine since Astro components aren't reactive */}
              <article class="group border border-border rounded-lg overflow-hidden transition-colors duration-150 ease hover:border-accent bg-bg">
                <a :href={`'${base}/proyectos/' + project.slug`} class="block">
                  <div class="aspect-video bg-surface overflow-hidden relative">
                    <template x-if="project.featured_image_url">
                      <img
                        :src="project.featured_image_url"
                        :alt="'Captura de ' + project.title"
                        loading="lazy"
                        class="w-full h-full object-cover transition-transform duration-300 ease group-hover:scale-[1.02]"
                        width="780"
                        height="439"
                      />
                    </template>
                    <template x-if="!project.featured_image_url">
                      <div class="w-full h-full flex items-center justify-center" style="font-family: var(--font-mono)">
                        <span class="text-secondary text-2xl" x-text="project.title.charAt(0).toUpperCase()"></span>
                      </div>
                    </template>
                  </div>

                  <div class="p-5">
                    <h3 class="text-[17px] font-medium text-text leading-snug group-hover:text-accent transition-colors duration-150" x-text="project.title"></h3>
                    <p class="mt-2 text-[15px] text-secondary leading-relaxed line-clamp-2" x-text="project.short_description" x-show="project.short_description"></p>

                    <div class="mt-4 flex flex-wrap items-center gap-2" style="font-family: var(--font-mono)">
                      <template x-for="(tech, idx) in project.technologies.slice(0, 3)" :key="tech.id">
                        <span class="inline-flex items-center px-2 py-0.5 text-[11px] bg-surface text-text rounded" x-text="tech.name"></span>
                      </template>
                      <span class="text-[11px] text-secondary" x-show="project.technologies.length > 3" x-text="'+' + (project.technologies.length - 3) + ' más'"></span>
                    </div>
                  </div>
                </a>
              </article>
            </div>
          </template>
        </div>

        {/* Empty state */}
        <p x-show="filtered.length === 0" class="text-secondary text-[15px] mt-8" style="display: none;">
          Nada aquí todavía con ese filtro.
        </p>
      </div>
    </div>
  </section>
</Layout>
