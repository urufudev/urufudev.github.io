---
import { marked } from 'marked';
import Layout from '../layouts/Layout.astro';
import GridBand from '../components/GridBand.astro';
import { getProfile, getExperiences, getEducation, getTechnologies } from '../lib/api';
import { formatPeriod } from '../lib/utils';

const profile = await getProfile();
const experiences = await getExperiences();
const education = await getEducation();
const techGroups = await getTechnologies();

function renderMarkdown(md: string | null): string {
  if (!md) return '';
  const html = marked.parse(md, { async: false, gfm: true, breaks: true }) as string;
  return html.replace(/<table([\s\S]*?)<\/table>/g, '<div class="md-table-wrap"><table$1</table></div>');
}

const bioHtml = renderMarkdown(profile.bio);

function formatTechLevel(level: number) {
  const isFiveScale = level <= 5;
  const percentage = isFiveScale
    ? Math.min(100, Math.max(0, level * 20))
    : Math.min(100, Math.max(0, level));
  const label = isFiveScale ? `${level} / 5` : `${level}%`;
  return { percentage, label };
}
---

<Layout title="Sobre mí" image={profile.avatar_url}>
  {/* Perfil */}
  <GridBand as="section">
    <div class="grid-inner py-12 lg:py-16">
      <div class="section-marker mb-4">
        <span>Perfil</span>
      </div>
      <h1 class="text-[34px] sm:text-[42px] lg:text-[48px] font-semibold tracking-tighter leading-[1.08] text-text">
        Sobre mí
      </h1>
      {bioHtml && (
        <div class="mt-8 md-content" set:html={bioHtml} />
      )}
    </div>
  </GridBand>

  {/* Experiencia */}
  <GridBand as="section">
    <div class="grid-inner py-10 lg:py-12 border-b border-border">
      <div class="section-marker mb-3">
        <span>Experiencia</span>
      </div>
      <h2 class="text-[24px] lg:text-[28px] font-semibold tracking-tight text-text">
        Trayectoria profesional
      </h2>
    </div>

    <div class="divide-y divide-border">
      {experiences.map((exp) => {
        const descHtml = renderMarkdown(exp.description);
        return (
          <div class="grid grid-cols-1 md:grid-cols-12">
            <div class="md:col-span-4 lg:col-span-3 grid-inner pt-8 pb-2 md:py-8 flex flex-row md:flex-col items-center md:items-start justify-between md:justify-start gap-2">
              <span class="text-[13px] text-secondary font-variant-numeric-tabular font-mono">
                {formatPeriod(exp.started_at, exp.ended_at, exp.is_current)}
              </span>
              {exp.work_type_label && (
                <span class="inline-block text-[12px] text-secondary bg-surface border border-border px-2 py-0.5 rounded-[3px] font-mono">
                  {exp.work_type_label}
                </span>
              )}
            </div>

            <div class="md:col-span-8 lg:col-span-9 grid-inner pt-2 pb-8 md:py-8 md:border-l md:border-border">
              <div class="flex flex-wrap items-center gap-3">
                <h3 class="text-[18px] font-semibold text-text">{exp.position}</h3>
                {exp.is_current && (
                  <span class="text-[12px] font-mono text-accent bg-surface border border-accent px-2 py-0.5 rounded-[3px]">
                    Actual
                  </span>
                )}
              </div>
              <p class="mt-1 text-[15px] text-secondary">{exp.company}</p>

              {descHtml && (
                <details class="mt-4 group">
                  <summary class="text-[13px] font-mono text-accent hover:text-accent-hover cursor-pointer list-none inline-flex items-center gap-1.5 transition-colors duration-150 btn-tactile select-none">
                    <span class="group-open:hidden">[+]</span>
                    <span class="hidden group-open:inline">[-]</span>
                    <span>Detalles</span>
                  </summary>
                  <div class="mt-4 pl-5 border-l border-border md-content text-[15px]" set:html={descHtml} />
                </details>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </GridBand>

  {/* Formación */}
  <GridBand as="section">
    <div class="grid-inner py-10 lg:py-12 border-b border-border">
      <div class="section-marker mb-3">
        <span>Formación</span>
      </div>
      <h2 class="text-[24px] lg:text-[28px] font-semibold tracking-tight text-text">
        Educación
      </h2>
    </div>

    <div class="divide-y divide-border">
      {education.map((edu) => {
        const descHtml = renderMarkdown(edu.description);
        return (
          <div class="grid grid-cols-1 md:grid-cols-12">
            <div class="md:col-span-4 lg:col-span-3 grid-inner pt-8 pb-2 md:py-8">
              <span class="text-[13px] text-secondary font-variant-numeric-tabular font-mono">
                {formatPeriod(edu.started_at, edu.ended_at, !edu.ended_at)}
              </span>
            </div>

            <div class="md:col-span-8 lg:col-span-9 grid-inner pt-2 pb-8 md:py-8 md:border-l md:border-border">
              <h3 class="text-[18px] font-semibold text-text">{edu.degree}</h3>
              <p class="mt-1 text-[15px] text-secondary">{edu.institution}</p>
              {descHtml && (
                <div class="mt-3 md-content text-[15px] text-secondary" set:html={descHtml} />
              )}
              {edu.certificate_url && (
                <a
                  href={edu.certificate_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-4 inline-flex items-center gap-1.5 text-[13px] font-mono text-accent hover:text-accent-hover transition-colors duration-150 underline-offset-4 hover:underline"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg>
                  <span>Certificado</span>
                </a>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </GridBand>

  {/* Habilidades */}
  <GridBand as="section">
    <div class="grid-inner py-10 lg:py-12 border-b border-border">
      <div class="section-marker mb-3">
        <span>Habilidades</span>
      </div>
      <h2 class="text-[24px] lg:text-[28px] font-semibold tracking-tight text-text">
        Stack técnico
      </h2>
    </div>

    <div class="divide-y divide-border">
      {techGroups.map((group) => (
        <div class="grid grid-cols-1 md:grid-cols-12">
          <div class="md:col-span-4 lg:col-span-3 grid-inner pt-8 pb-3 md:py-8">
            <h3 class="text-[13px] uppercase tracking-[0.08em] text-secondary font-mono font-medium">
              {group.label}
            </h3>
          </div>

          <div class="md:col-span-8 lg:col-span-9 grid-inner pt-2 pb-8 md:py-8 md:border-l md:border-border space-y-5">
            {group.technologies.map((tech) => {
              const { percentage, label } = formatTechLevel(tech.level);
              return (
                <div class="tech-bar" data-level={percentage}>
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-[15px] font-medium text-text">{tech.name}</span>
                    <span class="text-[12px] text-secondary font-mono font-variant-numeric-tabular">{label}</span>
                  </div>
                  <div class="h-[4px] bg-border rounded-[2px] overflow-hidden">
                    <div
                      class="tech-bar-fill h-full bg-accent rounded-[2px] transition-all duration-600 ease-out"
                      style="width: 0%;"
                    ></div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </GridBand>

  {/* Contacto directo */}
  <GridBand as="section">
    <div class="grid-inner py-10 lg:py-12 border-b border-border">
      <div class="section-marker mb-3">
        <span>Contacto</span>
      </div>
      <h2 class="text-[24px] lg:text-[28px] font-semibold tracking-tight text-text">
        Información directa
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-border">
      <div class="grid-inner py-8 space-y-4">
        <div class="flex items-center gap-4 py-2.5 border-b border-border">
          <span class="text-[12px] text-secondary w-24 shrink-0 font-mono uppercase tracking-[0.06em]">Email</span>
          <a href={`mailto:${profile.email}`} class="text-[15px] text-text hover:text-accent transition-colors duration-150 break-all">
            {profile.email}
          </a>
        </div>
        {profile.phone && (
          <div class="flex items-center gap-4 py-2.5 border-b border-border">
            <span class="text-[12px] text-secondary w-24 shrink-0 font-mono uppercase tracking-[0.06em]">Tel</span>
            <a href={`tel:${profile.phone}`} class="text-[15px] text-text hover:text-accent transition-colors duration-150">
              {profile.phone}
            </a>
          </div>
        )}
        {profile.location && (
          <div class="flex items-center gap-4 py-2.5 border-b border-border">
            <span class="text-[12px] text-secondary w-24 shrink-0 font-mono uppercase tracking-[0.06em]">Ubicación</span>
            <span class="text-[15px] text-text">{profile.location}</span>
          </div>
        )}
      </div>

      <div class="grid-inner py-8 flex flex-col justify-between gap-6">
        <div class="divide-y divide-border border-y border-border">
          {profile.social_links.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between py-3 text-[15px] text-text hover:text-accent transition-colors duration-150 group"
            >
              <span>{link.platform}</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-secondary group-hover:text-accent transition-transform duration-150 group-hover:translate-x-0.5" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
            </a>
          ))}
        </div>

        {profile.cv_url && (
          <div>
            <a
              href={profile.cv_url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2.5 text-[14px] font-medium bg-accent text-accent-contrast border border-accent hover:bg-accent-hover hover:border-accent-hover rounded-[4px] transition-colors duration-150 group btn-tactile"
            >
              <span>Descargar CV completo</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-150 group-hover:translate-y-0.5" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
            </a>
          </div>
        )}
      </div>
    </div>
  </GridBand>

  <script>
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const bar = entry.target.querySelector('.tech-bar-fill') as HTMLElement;
          const level = entry.target.getAttribute('data-level');
          if (bar && level) {
            bar.style.width = `${level}%`;
          }
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.2 });

    document.querySelectorAll('.tech-bar').forEach((el) => observer.observe(el));
  </script>
</Layout>
